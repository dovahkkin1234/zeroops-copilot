# ── LLM provider ──────────────────────────────────────────────────────────────
# "anthropic" (default) | "ollama" (free, local) | "google-gla" (Gemini API)
LLM_PROVIDER=anthropic

# Anthropic — only needed when LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Google Gemini — only needed when LLM_PROVIDER=google-gla
# Get a free API key from Google AI Studio (aistudio.google.com/apikey)
GOOGLE_API_KEY=...

# Model names — change both when switching providers:
#   Anthropic:  claude-opus-4-7 / claude-sonnet-5-5 / claude-haiku-5-5
#   Ollama:     qwen2.5:7b / llama3.1:8b (must support tool calls)
#   google-gla: gemini-4-hydrogen / gemini-3.1-pro-preview / gemini-2.5-flash
LLM_MODEL=claude-opus-4-7
UTILITY_MODEL=claude-haiku-4-5-20251001

# Ollama — only needed when LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434/v1

# ── Embeddings (always local, no provider switch) ─────────────────────────────
EMBED_MODEL=all-MiniLM-L6-v2

# ── Storage and paths ─────────────────────────────────────────────────────────
DB_PATH=./incidents.db
REPO_PATH=./demo_repo

# ── Agent behaviour ───────────────────────────────────────────────────────────
MAX_INVESTIGATION_LOOPS=8
REPRO_EXECUTION_ENABLED=false
