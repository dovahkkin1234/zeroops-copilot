# ── LLM provider ──────────────────────────────────────────────
# All committed benchmark runs used: LLM_PROVIDER=ollama / qwen2.5:7b
# "anthropic" and "google-gla" are supported but were not used in any
# committed evaluation run (Anthropic requires a paid API key).
LLM_PROVIDER=ollama

# ── Ollama (default — free, runs locally, no API key) ──────────────────
LLM_MODEL=qwen2.5:7b
UTILITY_MODEL=qwen2.5:7b
OLLAMA_BASE_URL=http://localhost:11434/v1
# See docs/RUNBOOK.md for Ollama setup and model pull commands.

# ── Optional: Anthropic Claude (requires a paid API key) ─────────────
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-opus-4-7
# UTILITY_MODEL=claude-haiku-4-5-20251001
# ANTHROPIC_API_KEY=sk-ant-...

# ── Optional: Google Gemini ───────────────────────────────────────────
# LLM_PROVIDER=google-gla
# LLM_MODEL=gemini-2.5-flash
# UTILITY_MODEL=gemini-2.5-flash
# GOOGLE_API_KEY=...

# ── Embeddings (always local, no provider switch) ──────────────────
EMBED_MODEL=all-MiniLM-L6-v2

# ── Storage and paths ─────────────────────────────────────────────
DB_PATH=./incidents.db
REPO_PATH=./demo_repo

# ── Agent behaviour ───────────────────────────────────────────────
MAX_INVESTIGATION_LOOPS=8
REPRO_EXECUTION_ENABLED=false
