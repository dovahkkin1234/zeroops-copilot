# Secrets — never in the image
.env
.env.*

# Local databases and graph cache
*.db
*.graph.json

# Python bytecode
__pycache__/
*.pyc
*.pyo
*.pyd

# Virtual environments
.venv/
venv/

# Git history (not needed at runtime; keeps image smaller)
.git/
.gitignore

# IDE and OS
.vscode/
.idea/
*.DS_Store
Thumbs.db

# Docs and site (not needed for tests or CLI)
docs/
site/

# Claude Code internal
.claude/
CLAUDE.md
MISSION.md
